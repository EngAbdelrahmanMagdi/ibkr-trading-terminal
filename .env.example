# Local development configuration for the Docker Compose environment.
#
# `make bootstrap` (also run by `make up`) copies this file to `.env` if it doesn't exist,
# and fills in generated values such as KAFKA_CLUSTER_ID.
#
# This file contains NO secrets. Passwords are generated by `make bootstrap` as individual files
# under ./secrets/, which is gitignored, and are mounted into containers as Docker secrets:
#   secrets/postgres_admin_password   PostgreSQL superuser (local administration only)
#   secrets/trading_owner_password    schema owner / migration role
#   secrets/trading_app_password      application role (DML only)
#   secrets/redis_app_password        Redis ACL user for applications
#   secrets/grafana_admin_password    Grafana admin UI

COMPOSE_PROJECT_NAME=trading-platform

# ---- Host ports (published on 127.0.0.1 only; change if a port is already in use) ----
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
KAFKA_HOST_PORT=19092
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000
TEMPO_HOST_PORT=13200
OTLP_GRPC_HOST_PORT=14317
OTLP_HTTP_HOST_PORT=14318

# ---- PostgreSQL ----
POSTGRES_DB=trading
POSTGRES_ADMIN_USER=trading_admin
TRADING_SCHEMA=trading
TRADING_OWNER_ROLE=trading_owner
TRADING_APP_ROLE=trading_app

# ---- Redis (disposable cache; all application keys must have a TTL) ----
REDIS_APP_USER=app
REDIS_MAXMEMORY=256mb

# ---- Kafka (single-node KRaft) ----
# Generated by `make bootstrap` when empty (base64url-encoded 16 random bytes).
KAFKA_CLUSTER_ID=

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
