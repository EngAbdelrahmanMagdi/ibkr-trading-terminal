{
  "name": "trading-terminal-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "format:check": "prettier --check src tests package.json *.json *.mjs *.ts",
    "format": "prettier --write src tests package.json *.json *.mjs *.ts",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "generate:types": "openapi-typescript ../../contracts/openapi/trading-api.yaml -o src/lib/contracts/trading.ts && openapi-typescript ../../contracts/openapi/realtime-gateway-api.yaml -o src/lib/contracts/gateway.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.0",
    "decimal.js": "10.6.0",
    "lightweight-charts": "5.2.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@next/eslint-plugin-next": "16.3.8",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
