{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.trading-terminal.invalid/schemas/events/kafka-headers.schema.json",
  "title": "KafkaHeaders",
  "description": "Kafka record headers set by every producer (UTF-8 encoded string values). They duplicate envelope fields so that tracing and routing work without parsing the payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "correlationId",
    "eventType",
    "eventVersion"
  ],
  "properties": {
    "correlationId": {
      "$ref": "../common/primitives.schema.json#/$defs/Uuid"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "eventVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,3}$"
    }
  }
}
