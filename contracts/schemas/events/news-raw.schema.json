{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.trading-terminal.invalid/schemas/events/news-raw.schema.json",
  "title": "NewsRaw",
  "description": "A deduplicated, normalized news article (topic news.raw.v1, key = the article's primary symbol).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "required": [
        "symbol"
      ],
      "properties": {
        "source": {
          "const": "trading-core"
        },
        "eventVersion": {
          "const": 1
        },
        "eventType": {
          "const": "NEWS_ARTICLE_INGESTED"
        },
        "payload": {
          "$ref": "#/$defs/Payload"
        }
      }
    }
  ],
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "articleId",
        "providerId",
        "symbols",
        "headline",
        "source",
        "url",
        "publishedAt",
        "rawSummary",
        "contentHash"
      ],
      "properties": {
        "articleId": {
          "$ref": "../common/primitives.schema.json#/$defs/Uuid"
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "../common/primitives.schema.json#/$defs/Symbol"
          }
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?://[^\\s]+$"
        },
        "publishedAt": {
          "$ref": "../common/primitives.schema.json#/$defs/UtcTimestamp"
        },
        "rawSummary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8000
        },
        "contentHash": {
          "description": "SHA-256 of the normalized content (hex).",
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
