{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.trading-terminal.invalid/schemas/stream/error.schema.json",
  "title": "StreamError",
  "description": "Server to client: recoverable protocol or subscription error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "code",
    "message"
  ],
  "properties": {
    "type": {
      "const": "error"
    },
    "code": {
      "type": "string",
      "enum": [
        "INVALID_MESSAGE",
        "UNKNOWN_SYMBOL",
        "SUBSCRIPTION_LIMIT",
        "MESSAGE_TOO_LARGE",
        "RATE_LIMITED",
        "SOURCE_UNAVAILABLE",
        "INTERNAL"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../common/primitives.schema.json#/$defs/Symbol"
      }
    }
  }
}
