{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.trading-terminal.invalid/schemas/news/news-article.schema.json",
  "title": "NewsArticle",
  "description": "A normalized news article. Enrichment is present only when AI enrichment succeeded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "symbols",
    "headline",
    "source",
    "url",
    "publishedAt",
    "rawSummary",
    "enrichment"
  ],
  "properties": {
    "id": {
      "$ref": "../common/primitives.schema.json#/$defs/Uuid"
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "../common/primitives.schema.json#/$defs/Symbol"
      }
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https?://[^\\s]+$"
    },
    "publishedAt": {
      "$ref": "../common/primitives.schema.json#/$defs/UtcTimestamp"
    },
    "rawSummary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8000
    },
    "enrichment": {
      "anyOf": [
        {
          "$ref": "enrichment.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
