# Local development configuration for the Docker Compose environment.
#
# `make bootstrap` (also run by `make up`) copies this file to `.env` if it doesn't exist,
# and fills in generated values such as KAFKA_CLUSTER_ID.
#
# This file contains NO secrets. Passwords are generated by `make bootstrap` as individual files
# under ./secrets/, which is gitignored, and are mounted into containers as Docker secrets:
#   secrets/postgres_admin_password   PostgreSQL superuser (local administration only)
#   secrets/trading_owner_password    schema owner / migration role
#   secrets/trading_app_password      application role (DML only)
#   secrets/redis_app_password        Redis ACL user for applications
#   secrets/grafana_admin_password    Grafana admin UI

COMPOSE_PROJECT_NAME=trading-platform

# ---- Host ports (published on 127.0.0.1 only; change if a port is already in use) ----
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
KAFKA_HOST_PORT=19092
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000
TEMPO_HOST_PORT=13200
OTLP_GRPC_HOST_PORT=14317
OTLP_HTTP_HOST_PORT=14318
GATEWAY_HOST_PORT=18090
GATEWAY_HEALTH_HOST_PORT=18091
WEB_HOST_PORT=3000

# ---- PostgreSQL ----
POSTGRES_DB=trading
POSTGRES_ADMIN_USER=trading_admin
TRADING_SCHEMA=trading
TRADING_OWNER_ROLE=trading_owner
TRADING_APP_ROLE=trading_app

# ---- Redis (disposable cache; all application keys must have a TTL) ----
REDIS_APP_USER=app
REDIS_MAXMEMORY=256mb

# ---- Kafka (single-node KRaft) ----
# Generated by `make bootstrap` when empty (base64url-encoded 16 random bytes).
KAFKA_CLUSTER_ID=

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin

# ---- Realtime gateway (gateway profile) ----
# Browser origins (host patterns) allowed to open the WebSocket; requests without an Origin header are allowed.
GATEWAY_ALLOWED_ORIGINS=localhost:3000,127.0.0.1:3000
# Seed of the deterministic market simulator: the same seed always produces the same prices and history.
GATEWAY_SEED=20260927
GATEWAY_TICK_INTERVAL=1s
GATEWAY_HEARTBEAT_INTERVAL=15s
GATEWAY_LOG_LEVEL=info
# Deterministic synthetic instruments SYN001..SYNnnn for load testing (`make load`); 0 disables them.
GATEWAY_SIM_SYNTHETIC_SYMBOLS=100
# Upper bound on symbols with an upstream subscription (a broker limits market-data lines).
GATEWAY_MAX_ACTIVE_SYMBOLS=150
# Symbols without an update for this long are reported stale.
GATEWAY_STALE_AFTER=5s

# ---- Trading Core (core profile) ----
TRADING_CORE_HOST_PORT=18080
TRADING_CORE_MANAGEMENT_HOST_PORT=18081
# Exact browser origins allowed to call the REST API (comma-separated; no wildcards).
TRADING_CORE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Web terminal (web profile, browser-visible URLs only; never put secrets here) ----
# These are embedded at image build time. If host ports change, update these URLs and rebuild web.
# Match WEB_HOST_PORT in the Core and Gateway exact-origin allowlists above.
WEB_CORE_ORIGIN=http://localhost:18080
WEB_GATEWAY_ORIGIN=http://localhost:18090
WEB_GATEWAY_WS_URL=ws://localhost:18090/ws

# ---- IBKR paper trading (make up-ibkr-paper; trusted, private environments only) ----
# Your IBKR paper trading account ID. Not a secret, but it identifies your account: keep it in the local .env.
IBKR_PAPER_ACCOUNT_ID=
# One IBKR session request budget is shared by both services (IBKR documents 10 requests per second per
# session): realtime gateway allocation (GATEWAY_IBKR_ALLOCATION, default 5) + Trading Core allocation +
# headroom (default 1) must not exceed the session limit (default 10). Each service refuses to start otherwise.
TRADING_CORE_IBKR_ALLOCATION=4
# News operational policy. The default Compose deployment uses synthetic fixtures only.
# Private provider selection and credentials belong in an explicit private override, never here.
NEWS_FRESHNESS=5m
NEWS_WINDOW=7d
NEWS_QUEUE_CAPACITY=16
NEWS_MAX_COLD_REQUESTS=4
NEWS_WORKERS=1
NEWS_DEADLINE=8s
NEWS_CONNECT_TIMEOUT=2s
NEWS_ATTEMPT_TIMEOUT=3s
NEWS_REQUESTS_PER_MINUTE=30
NEWS_ATTEMPTS=2
NEWS_MAX_RESPONSE_BYTES=2097152
NEWS_MAX_RECORDS=500
NEWS_BREAKER_FAILURES=5
NEWS_BREAKER_COOLDOWN=60s
NEWS_CLEANUP_INTERVAL=1h
NEWS_MAX_SYMBOLS=1000
NEWS_RETENTION=30d
NEWS_MAX_ARTICLES=50000
# Synthetic insight operational bounds; no external provider credential is required.
AI_STATE_KEYS=20000
AI_STATE_BYTES=67108864
AI_STATE_TTL=1209600
AI_INPUT_BYTES=16384
AI_RESPONSE_BYTES=131072
AI_DEADLINE=30
