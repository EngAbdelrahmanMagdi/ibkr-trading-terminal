{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.trading-terminal.invalid/schemas/stream/unsubscribe.schema.json",
  "title": "Unsubscribe",
  "description": "Client to server: unsubscribe from symbols.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "symbols"
  ],
  "properties": {
    "type": {
      "const": "unsubscribe"
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "../common/primitives.schema.json#/$defs/Symbol"
      }
    }
  }
}
